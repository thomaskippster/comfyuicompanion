{
  "$schema": "https://opencode.ai/config.json",
  "model": "ollama/qwen3.6-coder:32b-16k",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "qwen3.6-coder:32b": {
          "name": "Qwen-3.6-Coder",
          "tool_call": true,
          "type": "llm",
          "limits": {
            "context": 16384,
            "output": 4096
          },
          "description": "Qwen-3.6-Coder is a large language model designed for code generation and understanding.",
          "parameters": {
            "temperature": 0.2,
            "max_tokens": 4096
          }
        }
      }
    }
  }
}