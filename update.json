{
  "run": [
    {
      "method": "shell.run",
      "params": {
        "message": "git pull",
        "title": "Updating Source Code"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "conda": "env",
        "message": "conda install -y -c conda-forge \"openjdk>=21\" maven",
        "title": "Ensuring OpenJDK 21 & Maven"
      }
    },
    {
      "method": "shell.run",
      "params": {
        "conda": "env",
        "message": "mvn clean package -DskipTests",
        "title": "Rebuilding Application"
      }
    },
    {
      "method": "notify",
      "params": {
        "html": "Update complete! You can now start the application."
      }
    }
  ]
}
